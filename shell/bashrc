#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
# code abre la ventana en el workspace desde donde lo lanzas, aunque tarde y cambies de workspace
code() { ~/.config/hypr/scripts/ws-run.sh /usr/bin/code "$@"; }
eval "$(starship init bash)"
# colores de ls segun el tema actual (SUPER+T); vale desde la proxima terminal
export LS_COLORS="$(vivid generate "$(cat ~/.config/theme/vivid 2>/dev/null || echo gruvbox-dark)")"

fastfetch

# cosas propias de esta maquina (instaladores, PATH, etc.) que no van al repo
[[ -f ~/.bashrc.local ]] && . ~/.bashrc.local
