{
    "layer": "top",
    "position": "top",
    "height": 27,
    "margin": "4 8 0 8",
    "tooltip-timeout": 0,
    "modules-left": ["group/left", "custom/media"],
    "modules-center": ["group/center"],
    "modules-right": ["group/right"],

    "group/left": {
        "orientation": "horizontal",
        "modules": ["hyprland/workspaces"]
    },

	"group/center": {
		"orientation": "horizontal",
		"modules": ["clock"]
	},
	
    "group/right": {
        "orientation": "horizontal",
        "modules": ["battery", "cpu", "memory", "idle_inhibitor", "power-profiles-daemon", "bluetooth", "network", "custom/power"]
    },


    "custom/media": {
        "exec": "~/.config/waybar/scripts/media.sh",
        "return-type": "json",
        "format": "{}",
        "max-length": 45,
        "on-click": "playerctl --ignore-player vesktop,discord,Discord,WebCord play-pause",
        "tooltip": false
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰛑"
        },
        "tooltip": false
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "format-icons": {
            "performance": "󰑣",
            "balanced": "󰗑",
            "power-saver": "󰌪"
        },
        "tooltip": false
    },

	"battery": {
	    "states": {
	        "warning": 30,
	        "critical": 15
	    },
	    "format": "{icon}  {capacity}%",
	    "format-charging": "󰂄  {capacity}%",
	    "format-plugged": "󰂄  {capacity}%",
	    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
	    "tooltip": false
	},

    "clock": {
        "format": "{:%H:%M}  󰃭",
        "on-click": "pkill -x waycal || GSK_RENDERER=gl waycal",
        "tooltip": false
    },


	"network": {
        "format-wifi": "󰤨",
        "format-disconnected": "󰤭",
        "tooltip": false,
        "on-click": "pkill -x nmtui || kitty --class nmtui-float -o background_opacity=0.95 -e nmtui connect"
    },

    "bluetooth": {
        "format-on": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip": false,
        "on-click": "pkill -x blueman-manager || blueman-manager"
    },

	"custom/power": {
	    "format": "",
	    "on-click": "wlogout -b 4 --margin-top 325 --margin-bottom 325 --margin-left 320 --margin-right 320",
	    "tooltip": false
	},

    "cpu": {
        "format": "  {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": "󰍛  {used}G/{total}G",
        "tooltip": false
    }
}
