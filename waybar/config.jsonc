{
    "layer": "top",
    "position": "top",
    "height": 27,
    "margin": "4 8 0 8",
    "tooltip-timeout": 0,
    "modules-left": ["group/left", "mpris"],
    "modules-center": ["group/center"],
    "modules-right": ["tray", "group/right"],

    "group/left": {
        "orientation": "horizontal",
        "modules": ["hyprland/workspaces"]
    },

	"group/center": {
		"orientation": "horizontal",
		"modules": ["clock"]
	},
	
    "group/right": {
        "orientation": "horizontal",
        "modules": ["battery", "cpu", "memory", "bluetooth", "network", "idle_inhibitor", "power-profiles-daemon", "custom/power"]
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8,
        "show-passive-items": false
    },

    "mpris": {
        "format": "{player_icon}  {artist} - {title}",
        "format-paused": "",
        "format-stopped": "",
        "player-icons": {
            "default": "",
            "spotify": ""
        },
        "ignored-players": ["vesktop", "discord", "Discord", "WebCord"],
        "max-length": 45,
        "on-click": "playerctl play-pause",
        "tooltip": false
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰛑"
        },
        "tooltip": false
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "format-icons": {
            "performance": "󰑣",
            "balanced": "󰗑",
            "power-saver": "󰌪"
        },
        "tooltip": false
    },

	"battery": {
	    "states": {
	        "warning": 30,
	        "critical": 15
	    },
	    "format": "{icon}  {capacity}%",
	    "format-charging": "󰂄  {capacity}%",
	    "format-plugged": "󰂄  {capacity}%",
	    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
	    "tooltip": false
	},

    "clock": {
        "format": "{:%H:%M}  󰃭",
        "on-click": "pkill -x waycal || GSK_RENDERER=gl waycal",
        "tooltip": false
    },


	"network": {
        "format-wifi": "󰤨",
        "format-disconnected": "󰤭",
        "tooltip": false,
        "on-click": "pkill -x networkmanager_dmenu || networkmanager_dmenu"
    },

    "bluetooth": {
        "format-on": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip": false,
        "on-click": "pkill -x blueman-manager || blueman-manager"
    },

	"custom/power": {
	    "format": "",
	    "on-click": "wlogout -b 4 --margin-top 325 --margin-bottom 325 --margin-left 320 --margin-right 320",
	    "tooltip": false
	},

    "cpu": {
        "format": "  {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": "󰍛  {used}G/{total}G",
        "tooltip": false
    }
}
